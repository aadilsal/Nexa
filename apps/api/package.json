{
  "name": "@nexa/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && nest build",
    "dev": "dotenv -e ../../.env -- nest start --watch",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate && prisma generate --schema=prisma/analytics/schema.prisma",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:push": "dotenv -e ../../.env -- prisma db push && dotenv -e ../../.env -- prisma db push --schema=prisma/analytics/schema.prisma",
    "db:studio": "dotenv -e ../../.env -- prisma studio"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.3",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.3",
    "@nestjs/platform-express": "^11.1.3",
    "@nestjs/swagger": "^11.2.0",
    "@nexa/emails": "workspace:*",
    "@nexa/finance-engine": "workspace:*",
    "@nexa/shared": "workspace:*",
    "@prisma/client": "^6.11.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "ioredis": "^5.11.1",
    "otplib": "^12.0.1",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.16.0",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.5",
    "@nestjs/schematics": "^11.0.5",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.32",
    "prisma": "^6.11.1",
    "dotenv-cli": "^8.0.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
