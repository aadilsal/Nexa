{
  "name": "nexa",
  "private": true,
  "scripts": {
    "dev": "dotenv -e .env -- turbo dev",
    "dev:clean": "node scripts/kill-port.mjs 3000 && dotenv -e .env -- turbo dev",
    "build": "dotenv -e .env -- turbo build",
    "lint": "turbo lint",
    "test": "dotenv -e .env -- turbo test",
    "smoke": "node scripts/smoke-test.mjs"
  },
  "devDependencies": {
    "dotenv-cli": "^8.0.0",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  }
}
