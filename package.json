{
  "name": "nexa",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "db:generate": "dotenv -e .env -o -- pnpm --filter @nexa/api db:generate",
    "db:migrate": "dotenv -e .env -o -- pnpm --filter @nexa/api db:migrate",
    "db:push": "dotenv -e .env -o -- pnpm --filter @nexa/api db:push",
    "db:studio": "dotenv -e .env -o -- pnpm --filter @nexa/api db:studio"
  },
  "devDependencies": {
    "dotenv-cli": "^8.0.0",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  }
}
