# ─── Database ───────────────────────────────────────────────
DATABASE_URL=postgresql://nexa:nexa@localhost:5432/nexa
ANALYTICS_DATABASE_URL=postgresql://nexa:nexa@localhost:5432/nexa_analytics

# ─── Redis ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Encryption ─────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KEK=

# ─── Auth (Better Auth) ─────────────────────────────────────
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# ─── Admin ──────────────────────────────────────────────────
# Promotes this user to SUPER_ADMIN on API boot (must exist already)
ADMIN_SEED_EMAIL=
# Require MFA for all admin roles (default: only ADMIN + SUPER_ADMIN)
ADMIN_MFA_REQUIRED=false

# ─── Analytics (Nexa SDK) ───────────────────────────────────
ANALYTICS_USER_HASH_SALT=
ANALYTICS_EVENT_SIGNING_SECRET=

# ─── AI (Groq) ──────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ─── Email (Resend) ─────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM=Nexa <onboarding@resend.dev>

# ─── Cron (weekly emails, account purge, admin aggregation) ─
CRON_SECRET=

# ─── Passkeys ───────────────────────────────────────────────
PASSKEY_RP_ID=localhost

# ─── API ────────────────────────────────────────────────────
API_PORT=4000
CORS_ORIGIN=http://localhost:3000

# ─── Currency ───────────────────────────────────────────────
# Live rates fetched from Frankfurter API (cached 1h in Redis). No API key required.

# ─── Frontend ───────────────────────────────────────────────
# All apps read this single file at the repo root — do not copy to apps/*/.env
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_VERSION=0.0.1

# ─── Production deploy (GitHub Actions secrets) ─────────────
# RENDER_DEPLOY_HOOK=
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api/v1
# NEXT_PUBLIC_APP_URL=https://app.yourdomain.com
