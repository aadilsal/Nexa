# ─── Database ───────────────────────────────────────────────
DATABASE_URL=postgresql://nexa:nexa@localhost:5434/nexa

# ─── Redis ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Encryption ─────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KEK=

# ─── Auth (Better Auth) ─────────────────────────────────────
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# ─── AI (Groq) ──────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ─── Email (Resend) ─────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM=Nexa <onboarding@resend.dev>

# ─── Cron (weekly review emails + account purge) ────────────
CRON_SECRET=

# ─── Passkeys ───────────────────────────────────────────────
PASSKEY_RP_ID=localhost

# ─── Analytics (first-party) ─────────────────────────────────
ANALYTICS_DATABASE_URL=postgresql://nexa:nexa@localhost:5434/nexa_analytics
ANALYTICS_USER_HASH_SALT=
ANALYTICS_EVENT_SIGNING_SECRET=

ADMIN_MFA_REQUIRED=false

# Seed first admin user role on startup (optional)
ADMIN_SEED_EMAIL=

# ─── API ────────────────────────────────────────────────────
API_PORT=4000
CORS_ORIGIN=http://localhost:3000

# ─── Frontend ───────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
