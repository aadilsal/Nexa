FROM node:24-alpine AS base
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json ./apps/api/
COPY packages/shared/package.json ./packages/shared/
COPY packages/finance-engine/package.json ./packages/finance-engine/
COPY packages/emails/package.json ./packages/emails/
RUN pnpm install --frozen-lockfile --filter @nexa/api...

FROM base AS build
# Copy full install tree (root + package-level node_modules symlinks), then overlay source.
COPY --from=deps /app ./
COPY . .
RUN pnpm --filter @nexa/shared build
RUN pnpm --filter @nexa/finance-engine build
RUN pnpm --filter @nexa/emails build
RUN pnpm --filter @nexa/api exec prisma generate
RUN pnpm --filter @nexa/api exec prisma generate --schema=prisma/analytics/schema.prisma
RUN pnpm --filter @nexa/api build

# pnpm deploy: portable prod layout with all deps correctly linked (no broken symlinks).
FROM base AS deploy
COPY --from=build /app ./
RUN pnpm deploy --filter=@nexa/api --prod /prod/api

FROM node:24-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
COPY --from=deploy /prod/api ./
COPY --from=build /app/apps/api/dist ./dist
COPY --from=build /app/apps/api/prisma ./prisma
# Second Prisma schema outputs to apps/api/node_modules/.prisma/analytics-client (not @prisma/client).
COPY --from=build /app/apps/api/node_modules/.prisma/analytics-client ./node_modules/.prisma/analytics-client
EXPOSE 4000
CMD ["node", "dist/main.js"]
